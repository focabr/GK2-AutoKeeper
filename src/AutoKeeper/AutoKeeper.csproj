<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- GK2 runs Mono (Unity 6000.3) with a .NET Standard 2.1 profile — same target as GK2 Mod Framework. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AutoKeeper</AssemblyName>
    <RootNamespace>AutoKeeper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=AutoKeeper/</PathMap>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Assembly-CSharp references System.IO.Compression 4.2; the conflict with the netstandard facade is harmless. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <!--
      UseNuGetRefs=true: BepInEx/Harmony/UnityEngine come from the NuGet packages (BepInEx.Core, UnityEngine.Modules),
      useful in CI. Default (false): uses the DLLs from YOUR game installation, which match the version in use exactly.
      The game DLLs (Assembly-CSharp etc.) always come from the local installation and are never copied/redistributed.
    -->
    <UseNuGetRefs Condition="'$(UseNuGetRefs)' == ''">false</UseNuGetRefs>
    <RestoreAdditionalProjectSources Condition="'$(UseNuGetRefs)' == 'true'">https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Option A: NuGet packages (compile only, nothing is copied to the output). -->
  <ItemGroup Condition="'$(UseNuGetRefs)' == 'true'">
    <PackageReference Include="BepInEx.Core" Version="5.4.*" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.9" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <!-- Option B (default): DLLs from the local installation. Private=false => never copied to bin/. -->
  <ItemGroup Condition="'$(UseNuGetRefs)' != 'true'">
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManagedDir)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Game assemblies: compile-time references only (Private=false). -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(GameManagedDir)/LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManagedDir)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask"><HintPath>$(GameManagedDir)/UniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AstarPathfindingProject"><HintPath>$(GameManagedDir)/AstarPathfindingProject.dll</HintPath><Private>false</Private></Reference>
    <!-- Navigation between areas (AstarPath / NavGraph inherit types from these assemblies). -->
    <Reference Include="PackageTools"><HintPath>$(GameManagedDir)/PackageTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(GameManagedDir)/Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Drawing"><HintPath>$(GameManagedDir)/Drawing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(GameManagedDir)/Unity.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(GameManagedDir)/Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <!-- Native UI: the game's own uGUI and TextMeshPro (settings window with the game's look). -->
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManagedDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Clear message when the game path has not been configured. -->
  <Target Name="ValidateGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GamePath)' == ''" Text="GamePath is not set. Create GamePath.props (see GamePath.props.example), set the GK2_GAME_PATH variable or use -p:GamePath=..." />
    <Error Condition="!Exists('$(GameManagedDir)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found in '$(GameManagedDir)'. Check GamePath." />
    <Error Condition="'$(UseNuGetRefs)' != 'true' and !Exists('$(BepInExDir)/core/BepInEx.dll')" Text="BepInEx not found in '$(BepInExDir)/core'. Install BepInEx 5.4.23.x in the game or use -p:UseNuGetRefs=true." />
  </Target>

</Project>
