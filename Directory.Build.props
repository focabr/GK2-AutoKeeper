<Project>
  <!--
    Settings shared by all projects in the repository.

    Game path (NEVER hard-coded):
      1) environment variable GK2_GAME_PATH, or
      2) local file GamePath.props (ignored by git) — see GamePath.props.example, or
      3) on the command line: dotnet build -p:GamePath="D:\...\Graveyard Keeper 2"
  -->
  <Import Project="$(MSBuildThisFileDirectory)GamePath.props" Condition="Exists('$(MSBuildThisFileDirectory)GamePath.props')" />

  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == '' and '$(GK2_GAME_PATH)' != ''">$(GK2_GAME_PATH)</GamePath>
    <GameManagedDir>$(GamePath)/GraveyardKeeper2_Data/Managed</GameManagedDir>
    <BepInExDir>$(GamePath)/BepInEx</BepInExDir>

    <!-- Single mod version (SemVer). Plugin.cs repeats the value in Plugin.Version. -->
    <Version>0.3.43</Version>
    <Authors>focabr</Authors>
    <Company>focabr</Company>
    <Product>GK2 AutoKeeper</Product>
  </PropertyGroup>
</Project>
